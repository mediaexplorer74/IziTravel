<UserControl x:Class="Izi.Travel.Media.Views.Image.ImageMediaPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:image="using:Izi.Travel.Media.ViewModels.Image"
             xmlns:converters="using:Izi.Travel.Mtg.Converters"
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress Ring Overlay -->
        <ProgressRing Grid.Row="0"
                     IsActive="{Binding SelectedImage.IsBusy}"
                     Foreground="White"
                     Width="60"
                     Height="60"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="{Binding SelectedImage.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Standard UWP FlipView -->
        <FlipView Grid.Row="0"
                 ItemsSource="{Binding Images}"
                 SelectedItem="{Binding SelectedImage, Mode=TwoWay}">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="image:ImageMediaPlayerItemViewModel">
                    <Border Margin="1" Background="Transparent">
                        <Image Source="{x:Bind UrlHigh, Mode=OneWay}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <StackPanel VerticalAlignment="Top" 
                    IsHitTestVisible="False">

            <StackPanel.Background>
                <SolidColorBrush Color="{StaticResource IziTravelDarkColor}" Opacity="0.5" />
            </StackPanel.Background>

            <TextBlock Text="{Binding SelectedImageIndex}" 
                       FlowDirection="LeftToRight"
                       Margin="15,13,15,10" 
                       FontSize="26"
                       HorizontalAlignment="Left"
                       Foreground="White" />

        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" 
                    IsHitTestVisible="False" 
                    Visibility="{Binding SelectedImage.Title, Converter={StaticResource NullOrEmptyStringToInvisibilityConverter}}">

            <StackPanel.Background>
                <SolidColorBrush Color="{StaticResource IziTravelDarkColor}" Opacity="0.5" />
            </StackPanel.Background>

            <TextBlock Text="{Binding SelectedImage.Title}"
                       Margin="15,13,15,10" 
                       FontSize="26" 
                       MaxHeight="125"
                       Foreground="White" 
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis" />

        </StackPanel>

    </Grid>
</UserControl>

