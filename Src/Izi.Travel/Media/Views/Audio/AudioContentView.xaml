<UserControl x:Class="Izi.Travel.Media.Views.Audio.AudioContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:audio="using:Izi.Travel.Media.ViewModels.Audio"
             xmlns:controls="using:Izi.Travel.Core.Controls"
             xmlns:mediaConverters="using:Izi.Travel.Media.Converters"
             xmlns:mtgConverters="using:Izi.Travel.Mtg.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=audio:AudioContentViewModel, IsDesignTimeCreatable=True}"
             x:Name="PartAudioContentView"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

    <UserControl.Resources>
        <mediaConverters:PercentageToPointConverter x:Key="PercentageToPointConverter" />
        <mediaConverters:PercentageToLargeArcConverter x:Key="PercentageToLargeArcConverter" />
    </UserControl.Resources>

    <controls:ActionRoundButton Command="{Binding ToggleCommand}"
                                Style="{StaticResource MediaRoundButtonStyle}">
        <controls:ActionRoundButton.Content>
            <TextBlock Text="{Binding Title, ElementName=PartAudioContentView}"
                       Style="{StaticResource MediaRoundButtonContentTextBoxStyle}" 
                       Visibility="{Binding Title, ElementName=PartAudioContentView, Converter={StaticResource NullToInvisibilityConverter}}"/>
        </controls:ActionRoundButton.Content>
        <controls:ActionRoundButton.ButtonOverlayContent>
            <Viewbox Width="40" Height="40" Visibility="{Binding IsStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <!-- Background circle -->
                    <Ellipse Width="40" 
                             Height="40" 
                             Stroke="{StaticResource IziTravelGrayBrush}"
                             StrokeThickness="4"
                             Opacity="0.5" />
                    
                    <!-- Progress arc using ArcSegment -->
                    <Path Stroke="{StaticResource IziTravelBlueBrush}" 
                          StrokeThickness="4"
                          StrokeLineJoin="Round">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="20,0">
                                    <ArcSegment Point="{Binding Percentage, Converter={StaticResource PercentageToPointConverter}}"
                                              Size="20,20"
                                              SweepDirection="Clockwise"
                                              IsLargeArc="{Binding Percentage, Converter={StaticResource PercentageToLargeArcConverter}}" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Grid>
            </Viewbox>
        </controls:ActionRoundButton.ButtonOverlayContent>
    </controls:ActionRoundButton>
</UserControl>

