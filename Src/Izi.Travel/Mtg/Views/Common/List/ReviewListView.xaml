<UserControl x:Class="Izi.Travel.Shell.Mtg.Views.Common.List.ReviewListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:behaviors="clr-namespace:Izi.Travel.Shell.Core.Components.Behaviors"
             xmlns:controls="using:Izi.Travel.Shell.Controls"
             xmlns:rating="using:Izi.Travel.Shell.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="400">

    <UserControl.Resources>
        <Storyboard x:Name="TiltStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.95"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.95"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="AverageRatingStyle" TargetType="rating:RatingControl">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FilledBrush" Value="{StaticResource IziTravelVioletBrush}" />
            <Setter Property="UnfilledBrush" Value="{StaticResource IziTravelLightGrayBrush}" />
            <Setter Property="ItemMargin" Value="8" />
            <Setter Property="ItemSize" Value="24" />
        </Style>

        <Style x:Key="ReviewRatingStyle" TargetType="rating:RatingControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Margin" Value="-2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FilledBrush" Value="{StaticResource IziTravelDarkBrush}" />
            <Setter Property="UnfilledBrush" Value="{StaticResource IziTravelGrayBrush}" />
            <Setter Property="ItemMargin" Value="3" />
            <Setter Property="ItemSize" Value="16" />
        </Style>

        <Style x:Key="RateButtonStyle" TargetType="Button">
            <!-- Tilt effect removed for UWP compatibility -->
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <CompositeTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="PointerPressed" Value="Button_PointerPressed"/>
            <Setter Property="PointerReleased" Value="Button_PointerReleased"/>
            <Setter Property="PointerCanceled" Value="Button_PointerReleased"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Fill" Storyboard.TargetName="Ellipse">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource IziTravelBlueBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="TextBlock">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource IziTravelLightBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Stroke" Storyboard.TargetName="Ellipse">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource IziTravelGrayBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="TextBlock">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource IziTravelGrayBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="LabelTextBlock">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource IziTravelGrayBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid Margin="{TemplateBinding Padding}" 
                                  Height="48" 
                                  VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         x:Name="Ellipse"
                                         Height="48"
                                         Width="48"
                                         Stroke="{StaticResource IziTravelBlueBrush}"
                                         StrokeThickness="3" />
                                <TextBlock Grid.Column="0"
                                           x:Name="TextBlock"
                                           Margin="9,-3,0,0"
                                           Text="★"
                                           FontSize="36"
                                           Foreground="{StaticResource IziTravelBlueBrush}" />
                                <TextBlock Grid.Column="1"
                                           x:Name="LabelTextBlock"
                                           Margin="23,3,0,0"
                                           Foreground="{StaticResource IziTravelBlueBrush}" 
                                           Text="{Binding LocalizedResources.CommandRateAndReview, Source={StaticResource LocalizedStrings}}" 
                                           FontSize="{StaticResource IziTravelFontSizeMedium}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    
    <Grid Margin="24,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:LongListSelector Grid.Row="1"
                                Margin="0,0,-25,0"
                                ItemsSource="{Binding Items}"
                                LoadCommand="{Binding LoadDataCommand}"
                                Style="{StaticResource LongListSelectorStyle}">
            <controls:LongListSelector.ListHeader>
                <Grid Margin="0,0,25,40">
                    <StackPanel>
                        <StackPanel Height="136"
                                    Orientation="Horizontal" 
                                    Margin="0,0,0,1"
                                    Background="{StaticResource IziTravelLightBrush}">
                            <TextBlock Margin="31,14,-10,0"
                                       Visibility="{Binding IsRated, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding AverageString}"
                                       FontSize="74"
                                       FontFamily="{StaticResource IziTravelFontFamilySegoeLight}"
                                       Foreground="{StaticResource IziTravelVioletBrush}" />
                            <StackPanel Margin="10,0,0,0">
                                <rating:RatingControl Margin="16,31,0,0" 
                                                  Style="{StaticResource AverageRatingStyle}" 
                                                  Value="{Binding AverageRating, Mode=OneWay}" 
                                                  Maximum="5" />
                                <TextBlock Margin="26,2,0,0"
                                           Visibility="{Binding IsRated, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="{Binding CountString}"
                                           Foreground="{StaticResource IziTravelGrayBrush}"
                                           FontSize="{StaticResource IziTravelFontSizeSmall}" />
                                <TextBlock Margin="26,2,0,0"
                                           Visibility="{Binding IsRated, Converter={StaticResource BoolToInvisibilityConverter}}"
                                           Text="{Binding LocalizedResources.LabelNoRatings, Source={StaticResource LocalizedStrings}}"
                                           Foreground="{StaticResource IziTravelGrayBrush}"
                                           FontSize="{StaticResource IziTravelFontSizeSmall}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Background="{StaticResource IziTravelLightBrush}">
                            <Button Padding="34,16,0,16"
                                    Command="{Binding RateCommand}"
                                    Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource RateButtonStyle}" />
                            <StackPanel Margin="33,8,24,14"
                                        Visibility="{Binding CanRate, Converter={StaticResource BoolToInvisibilityConverter}}">
                                <TextBlock Text="{Binding LocalizedResources.LabelRatedTitle, Source={StaticResource LocalizedStrings}}"
                                           FontFamily="{StaticResource IziTravelFontFamilySegoeSemibold}"
                                           FontSize="{StaticResource IziTravelFontSizeMedium}" />
                                <TextBlock Text="{Binding LocalizedResources.LabelRatedMessage, Source={StaticResource LocalizedStrings}}"
                                           Foreground="{StaticResource IziTravelGrayBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource IziTravelFontSizeSmall}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Height="100"
                               VerticalAlignment="Bottom"
                               TextWrapping="Wrap"
                               Text="{Binding IsListEmptyPlaceholder}"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{StaticResource IziTravelGrayBrush}"
                               FontSize="{StaticResource IziTravelFontSizeNormal}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="140" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Height="100"
                               VerticalAlignment="Bottom"
                               TextWrapping="Wrap"
                               Text="{Binding LocalizedResources.ActionLoading, Source={StaticResource LocalizedStrings}}" 
                               FontFamily="{StaticResource IziTravelFontFamilySegoeNormal}"
                               FontSize="{StaticResource IziTravelFontSizeMedium}"
                               Foreground="{StaticResource IziTravelDarkGrayBrush}"
                               Visibility="{Binding IsDataLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="140" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </controls:LongListSelector.ListHeader>
            <controls:LongListSelector.ListFooter>
                <Border Height="72" />
            </controls:LongListSelector.ListFooter>
            <controls:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,24,38" 
                          Background="{StaticResource IziTravelLightGrayBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Margin="0,0,0,5"
                                   Text="{Binding ReviewerName}" 
                                   FontSize="{StaticResource IziTravelFontSizeMedium}" 
                                   FontFamily="{StaticResource IziTravelFontFamilySegoeSemibold}" />
                        <rating:RatingControl Grid.Row="1" 
                                         Style="{StaticResource ReviewRatingStyle}" 
                                         Value="{Binding Rating, Mode=OneWay}" 
                                         Maximum="5" />
                        <TextBlock Grid.Row="1" 
                                   HorizontalAlignment="Right"
                                   FontSize="{StaticResource IziTravelFontSizeSmall}"
                                   Foreground="{StaticResource IziTravelGrayBrush}"
                                   Text="{Binding Date, Converter={StaticResource DateTimeToShortDateStringConverter}}" />
                        <TextBlock Grid.Row="2" 
                                   Margin="0,6,0,0"
                                   Text="{Binding Text}" 
                                   FontSize="{StaticResource IziTravelFontSizeNormal}"
                                   Visibility="{Binding Text, Converter={StaticResource NullToInvisibilityConverter}}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </controls:LongListSelector.ItemTemplate>
        </controls:LongListSelector>
    </Grid>
</UserControl>