<Page x:Class="Izi.Travel.Mtg.Views.Common.Player.InfoPartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:i="using:Microsoft.Xaml.Interactivity"
      xmlns:components="using:Izi.Travel.Common.Components"
      xmlns:converters="using:Izi.Travel.Mtg.Converters"
      xmlns:controls="using:Izi.Travel.Mtg.Controls"
      xmlns:corecontrols="using:Izi.Travel.Core.Controls"
      xmlns:commoncontrols="using:Izi.Travel.Common.Controls"
      Style="{StaticResource IziTravelPageStyle}"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:MtgObjectTypeToStringConverter x:Key="MtgObjectTypeToStringConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Alias for backward compatibility -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="25,0,25,0">

                <TextBlock Margin="0,30,0,0"
                           Text="{Binding LocalizedResources.LabelInfo, Source={StaticResource LocalizedStrings}, Converter={StaticResource StringToUpperConverter}}"
                           TextWrapping="Wrap"
                           Style="{StaticResource FlyoutTitleStyle}" />

                <!-- ImagesFlipView temporarily replaced with a placeholder -->
                <Border Margin="0,30,0,0" 
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        Height="200"
                        CornerRadius="4"
                        Visibility="{Binding HasImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding LocalizedResources.LabelImagesNotAvailable, Source={StaticResource LocalizedStrings}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20"/>
                </Border>

                <TextBlock Margin="0,30,0,0"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           
                           FontSize="{StaticResource IziTravelFontSizeNormal}"
                           Foreground="{StaticResource IziTravelDarkBrush}" />

                <StackPanel Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Margin="0,35,0,25"
                               Text="{Binding LocalizedResources.LabelRelated, Source={StaticResource LocalizedStrings}}"
                               Foreground="{StaticResource IziTravelDarkGrayBrush}"
                               FontSize="{StaticResource IziTravelFontSizeNormal}"
                               />
                    <!-- Related items would go here -->
                </StackPanel>

                <Border Height="90" />

            </StackPanel>
        </ScrollViewer>

        <!-- UWP CommandBar at the bottom -->
        <CommandBar Grid.Row="1"
                   Style="{StaticResource IziTravelCommandBarStyle}"
                   DefaultLabelPosition="Right"
                   IsOpen="False"
                   IsSticky="True"
                   Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            
            <!-- Primary Commands (right side) -->
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="Share"
                             Icon="Share"
                             Label="{Binding LocalizedResources.CommandShare, Source={StaticResource LocalizedStrings}}"
                             Command="{Binding ShareCommand}" />
                
                <AppBarToggleButton x:Name="ToggleBookmark"
                                  Icon="Favorite"
                                  Label="{Binding LocalizedResources.CommandBookmark, Source={StaticResource LocalizedStrings}}"
                                  IsChecked="{Binding ToggleBookmarkCommand.HasBookmark, Mode=TwoWay}"
                                  Command="{Binding ToggleBookmarkCommand}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Grid>
</Page>