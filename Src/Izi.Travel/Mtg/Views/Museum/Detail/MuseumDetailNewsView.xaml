<UserControl x:Class="Izi.Travel.Mtg.Views.Museum.Detail.MuseumDetailNewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
           
    
    <ScrollViewer>
        <StackPanel Margin="25,0,25,0">
            <!-- Replaced ExpandableTextBlock with TextBlock for MVP -->
            <TextBlock Text="{Binding News}"
                        
                       FontSize="{StaticResource IziTravelFontSizeNormal}"
                       TextWrapping="Wrap"/>
        
            <Border Height="72" />
        </StackPanel>
    </ScrollViewer>
</UserControl>