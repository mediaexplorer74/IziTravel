<Page x:Class="Izi.Travel.Mtg.Views.Tour.Map.TourMapPartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:i="using:Microsoft.Xaml.Interactivity"
      xmlns:corecontrols="clr-namespace:Izi.Travel.Core.Controls"
      xmlns:commoncontrols="clr-namespace:Izi.Travel.Common.Controls"
      xmlns:modulecontrols="clr-namespace:Izi.Travel.Mtg.Controls"
      xmlns:maps="using:Windows.UI.Xaml.Controls.Maps"
      xmlns:controls="using:Windows.UI.Xaml.Controls"
      xmlns:viewmodels="clr-namespace:Izi.Travel.Mtg.ViewModels.Tour.Map"
      xmlns:flyout="clr-namespace:Izi.Travel.Core.Controls.Flyout"
      xmlns:coreconverters="clr-namespace:Izi.Travel.Core.Converters"
      xmlns:moduleconverters="clr-namespace:Izi.Travel.Mtg.Converters"
      xmlns:audio="clr-namespace:Izi.Travel.Media.Views.Audio"
      xmlns:behaviors="clr-namespace:Izi.Travel.Core.Components.Behaviors"
      xmlns:converters="using:Izi.Travel.Converters"
      xmlns:toolkit="using:Izi.Travel.Toolkit.Controls.Maps"
      xmlns:sys="using:System"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="400"
      Style="{StaticResource IziTravelPageStyle}">

    <Page.Resources>
        <!-- Replaced TourMapItemStateToBrushConverter with direct binding to brush resources -->
        <SolidColorBrush x:Key="MapItemNormalBrush" Color="{StaticResource IziTravelBlueColor}" />
        <SolidColorBrush x:Key="MapItemSelectedBrush" Color="{StaticResource IziTravelLightColor}" />
        <SolidColorBrush x:Key="MapItemVisitedBrush" Color="{StaticResource IziTravelGrayColor}" />
        
        <!-- Simple margin values as strings that can be converted to Thickness where needed -->
        <sys:Double x:Key="MapPinSelectedMarginTop">8</sys:Double>
        <sys:Double x:Key="MapPinNormalMarginTop">2</sys:Double>
        <x:String x:Key="MapPinSelectedTextMargin">0,2,0,0</x:String>
        <x:String x:Key="MapPinNormalTextMargin">0,0,0,2</x:String>

