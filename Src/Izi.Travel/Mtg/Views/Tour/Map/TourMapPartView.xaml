        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid x:Name="MainGrid">
        <!-- Replaced ProgressOverlay with a simple busy indicator -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ProgressRing IsActive="{Binding IsBusy}" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"
                         Width="40"
                         Height="40"
                         Foreground="{StaticResource IziTravelBlueBrush}" />
            <Grid x:Name="MapGrid">
                <!-- Custom MapControl with UWP integration -->
                <maps:MapControl x:Name="Map"
                               ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                               Center="{Binding Center, Mode=TwoWay}"
                               MapElementClick="OnMapElementClick"
                               MapTapped="OnMapTapped"
                               Style="{StaticResource IziTravelMapStyle}">
                    <!-- Commented out MapViewBehavior as it's causing compilation issues -->
                    <!--<i:Interaction.Behaviors>
                        <behaviors:MapViewBehavior View="{Binding LocationRect, Mode=TwoWay}"
                                               ViewCenter="{Binding ViewCenter, Mode=TwoWay}" 
                                               ViewZoomLevel="{Binding ViewZoomLevel, Mode=TwoWay}" />
                    </i:Interaction.Behaviors>-->
                    
                    <!-- MapItemsControl for displaying items on the map -->
                    <maps:MapItemsControl x:Name="MapItems" 
                                       ItemsSource="{Binding Items}">
                        <maps:MapItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PinScale" 
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   To="1.2" 
                                                                   Duration="0:0:0.2" 
                                                                   EnableDependentAnimation="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="PinScale" 
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   To="1.2" 
                                                                   Duration="0:0:0.2" 
                                                                   EnableDependentAnimation="True"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="PinScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    
                                    <!-- Custom pin design -->
                                    <Border Width="40" 
                                            Height="40" 
                                            Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                            CornerRadius="20">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </maps:MapItemsControl.ItemTemplate>
                    </maps:MapItemsControl>
                </maps:MapControl>
            </Grid>
        </Grid>
    </Grid>
</Page>