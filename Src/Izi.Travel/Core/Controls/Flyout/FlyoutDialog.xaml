<UserControl
    x:Class="Izi.Travel.Shell.Core.Controls.Flyout.FlyoutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Izi.Travel.Shell.Core.Controls.Flyout"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid x:Name="RootGrid" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleTextBlock" 
                   Text="{x:Bind Title, Mode=OneWay}"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Message -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,16">
            <TextBlock x:Name="MessageTextBlock"
                       Text="{x:Bind Message, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"/>
        </ScrollViewer>

        <!-- Hyperlink -->
        <HyperlinkButton x:Name="HyperlinkButton"
                         Grid.Row="2"
                         Content="{x:Bind HyperlinkContent, Mode=OneWay}"
                         Visibility="{x:Bind IsHyperlinkVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Click="HyperlinkButton_OnClick"
                         Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="8,0,0,0"/>
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </StackPanel.Resources>
            <CheckBox x:Name="DontShowAgainCheckBox"
                      Content="Don't show again"
                      Visibility="{x:Bind IsDontShowVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{x:Bind IsDontShowEnabled, Mode=OneWay}"
                      VerticalAlignment="Center"/>

            <Button x:Name="LeftButton"
                    Content="{x:Bind LeftButtonContent, Mode=OneWay}"
                    Click="OnLeftButtonClick"
                    IsEnabled="{x:Bind IsLeftButtonEnabled, Mode=OneWay}"
                    MinWidth="120"/>

            <Button x:Name="RightButton"
                    Content="{x:Bind RightButtonContent, Mode=OneWay}"
                    Click="OnRightButtonClick"
                    IsEnabled="{x:Bind IsRightButtonEnabled, Mode=OneWay}"
                    MinWidth="120"
                    Visibility="{x:Bind IsRightButtonEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
