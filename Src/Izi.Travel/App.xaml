<micro:CaliburnApplication
    x:Class="Izi.Travel.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:micro="using:Caliburn.Micro"
    xmlns:local="using:Izi.Travel.Shell"
    xmlns:cnv="using:Izi.Travel.Shell.Converters"
    xmlns:appServices="local:IziTravel.AppServices;assembly=IziTravel.AppServices">

    <micro:CaliburnApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 2.x resources -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                
                <!-- Application-specific resources -->
                <ResourceDictionary Source="ms-appx:///Common/Themes/AppBarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </micro:CaliburnApplication.Resources>

</micro:CaliburnApplication>
