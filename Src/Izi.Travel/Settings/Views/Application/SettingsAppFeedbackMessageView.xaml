<Page x:Class="Izi.Travel.Settings.Views.Application.SettingsAppFeedbackMessageView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                            
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:commoncontrols="using:Izi.Travel.Common.Controls"
                            xmlns:i="using:Microsoft.Xaml.Interactivity"
                            xmlns:components="using:Izi.Travel.Common.Components"
                            xmlns:corecontrols="using:Izi.Travel.Core.Controls"
                            xmlns:extensions="using:Izi.Travel.Core.Components.Extensions"
                            xmlns:behaviors="using:Izi.Travel.Core.Components.Behaviors"
                            xmlns:controls="using:Izi.Travel.Toolkit.Controls"
                            mc:Ignorable="d"
                            Style="{StaticResource IziTravelPageStyle}">
    <Page.TopAppBar>
        <CommandBar Background="Transparent" 
                   DefaultLabelPosition="Right"
                   IsOpen="True" 
                   IsSticky="True">
            <AppBarButton Icon="Forward" 
                        Label="{Binding LocalizedResources.CommandNext, Source={StaticResource LocalizedStrings}}"
                        Command="{Binding NavigateCommand}" />
        </CommandBar>
    </Page.TopAppBar>

    <Grid>
        <i:Interaction.Behaviors>
            
        </i:Interaction.Behaviors>

    

  </Grid>
</Page>
