<UserControl
    x:Class="Izi.Travel.Controls.Map.MapItemsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:map="using:Windows.UI.Xaml.Controls.Maps"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    
    <Grid>
        <map:MapControl x:Name="Map" 
                       ZoomLevel="{x:Bind ZoomLevel, Mode=TwoWay}"
                       Center="{x:Bind Center, Mode=TwoWay}"
                       MapServiceToken="{x:Bind MapServiceToken}"
                       Style="{x:Bind MapStyle}"
                       LandmarkVisible="True"
                       PedestrianFeaturesVisible="True"
                       TrafficFlowVisible="False"
                       MapElementClick="OnMapElementClick">
            
            <map:MapItemsControl x:Name="MapItemsControl" 
                               ItemsSource="{x:Bind ItemsSource}"
                               ItemTemplate="{x:Bind ItemTemplate}">
                <map:MapItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" 
                                     ContentTemplate="{x:Bind ItemTemplate}" />
                    </DataTemplate>
                </map:MapItemsControl.ItemTemplate>
            </map:MapItemsControl>
            
        </map:MapControl>
    </Grid>
</UserControl>
