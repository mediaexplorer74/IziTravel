<UserControl
    x:Class="Izi.Travel.Controls.Map.MapItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="100"
    d:DesignWidth="100">
    
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Play Content -->
        <Grid x:Name="PlayContent"
              Grid.Row="0"
              Margin="{Binding IsSelected, Converter={StaticResource MapPinIsSelectedToPlayContentMarginConverter}}"
              Visibility="{Binding IsPlayContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Ellipse Width="40" 
                     Height="40"
                     Fill="{Binding State, Converter={StaticResource TourMapItemStateToBackgroundConverter}}"
                     Stroke="{Binding State, Converter={StaticResource TourMapItemStateToBorderConverter}}"
                     StrokeThickness="2" />
            <Image Source="/Assets/Icons/appbar.control.play.png"
                   Width="20" 
                   Height="20"
                   Margin="2,0,0,0" />
        </Grid>
        
        <!-- Text Content -->
        <Grid x:Name="TextContent"
              Grid.Row="1"
              Margin="{Binding IsSelected, Converter={StaticResource MapPinIsSelectedToTextContentMarginConverter}}"
              Visibility="{Binding IsTextContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{Binding State, Converter={StaticResource TourMapItemStateToBackgroundConverter}}"
                    BorderBrush="{Binding State, Converter={StaticResource TourMapItemStateToBorderConverter}}"
                    BorderThickness="2"
                    CornerRadius="2">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding State, Converter={StaticResource TourMapItemStateToForegroundConverter}}"
                           Margin="5,2,5,2"
                           FontSize="{StaticResource IziTravelFontSizeSmall}"
                           FontFamily="{StaticResource IziTravelFontFamilySegoeSemibold}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
