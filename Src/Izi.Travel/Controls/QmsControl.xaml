<UserControl
    x:Class="Izi.Travel.Controls.QmsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Izi.Travel.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    x:Name="Root">

    <Grid>
        <Grid x:Name="IconGrid"
              Width="{Binding IconSize, ElementName=Root}"
              Height="{Binding IconSize, ElementName=Root}">
            <Image x:Name="FallbackImage"
                   Source="ms-appx:///Assets/StoreLogo.png"
                   Visibility="Collapsed"
                   Stretch="Uniform" />
            <Image x:Name="IconRectangle"
                   Source="{Binding IconSource, ElementName=Root}"
                   Stretch="Uniform"
                   ImageFailed="IconImageBrush_ImageFailed"/>
        </Grid>
    </Grid>
</UserControl>
