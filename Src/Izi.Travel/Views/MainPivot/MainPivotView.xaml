
<Page
    x:Class="IziTravel.Views.MainPivot.MainPivotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Windows.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mainPivot="clr-namespace:IziTravel.AppServices.ViewModels.MainPivot;assembly=IziTravel.AppServices"
    xmlns:ctrl="using:Izi.Travel.Controls"
    xmlns:cal="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro"
    xmlns:cnv="clr-namespace:Izi.Travel.Controls.Placeholders;assembly=Izi.Travel"
    xmlns:mainPivot1="clr-namespace:IziTravel.Views.MainPivot"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:placeholders="using:Izi.Travel.Controls.Placeholders"
    mc:Ignorable="d" 
    d:DesignWidth="480" 
    d:DesignHeight="768"
    
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    d:DataContext="{d:DesignInstance mainPivot:MainPivotViewModel}">

    <Page.Resources>
        <placeholders:MarginSelector x:Key="MarginSelector"
                                  Portrait="0 10 0 0"
                                  LandscapeLeft="72 0 24 0"
                                  LandscapeRight="0 0 72 0"/>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Pivot Margin="{Binding Source={StaticResource OrientationMgr}, Path=Orientation, Converter={StaticResource MarginSelector}}">
            <Pivot.Title>
                <ctrl:HeaderControl />
            </Pivot.Title>

            <PivotItem Header="новости">
                <ContentControl Content="{Binding NewsViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </PivotItem>
            <PivotItem Header="форумы">
                <ContentControl Content="{Binding ForumsViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </PivotItem>
            <PivotItem Header="каталог">
                <!-- Add content for каталог -->
            </PivotItem>
            <PivotItem Header="избранное">
                <!-- Add content for избранное -->
            </PivotItem>
        </Pivot>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Contact" Label="профиль" Tag="Profile" 
                          Command="{Binding NavigateToProfileCommand}"/>
            <AppBarButton Icon="Find" Label="поиск" Tag="Search"
                          Command="{Binding NavigateToSearchCommand}"/>
            <AppBarButton Icon="Refresh" Label="обновить" Tag="Refresh"
                          Command="{Binding RefreshDataCommand}"/>
            <AppBarButton Icon="Setting" Label="настройки" Tag="Settings"
                          Command="{Binding NavigateToSettingsCommand}"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
