<Page
    x:Class="Izi.Travel.Views.Forum.ForumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IziTravel.Views.Forum"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:forum="using:Izi.Travel.AppServices.ViewModels.Forum"
    xmlns:micro="local:Caliburn.Micro;assembly=Caliburn.Micro"
    xmlns:behaviors="clr-namespace:IziTravel.Interaction.Behaviors"
    xmlns:i="clr-namespace:IziTravel.Interaction"
    xmlns:tp="using:Telerik.UI.Xaml.Controls.Primitives"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:controls="using:Izi.Travel.Controls"
    xmlns:dataModels="using:Izi.Travel.AppServices.DataModels" 
    xmlns:forum1="using:IziTravel.AppServices.ViewModels.Forum"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type=forum1:ForumPageViewModel}"   
    >
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedItemsSource" 
                            IsSourceGrouped="True" 
                            Source="{Binding AllItems}">
            <!-- In UWP, grouping is typically done in the ViewModel -->
            <!-- The collection should be pre-grouped in the ViewModel and exposed as a grouped collection -->
        </CollectionViewSource>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource IziTravelLightBrush}"
                Height="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="Title"
                    Content="{Binding ForumName, Converter={StaticResource StringCaseConverter}, ConverterParameter=l}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontSize="34"
                    
                    Margin="24 0 0 0">
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid x:Name="TransitionGrid">
                                <ContentPresenter x:Name="ContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="ContentTransform" X="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </ContentControl.Template>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                     VerticalAlignment="Center"
                                     Margin="24 0 0 0"
                                     Style="{StaticResource PhoneTextTitle2Style}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <controls:QmsControl Grid.Column="2"
                                 Margin="0 9 0 0"
                                 VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="0 32 0 0">
            <ListBox ItemsSource="{Binding Source={StaticResource GroupedItemsSource}}"
                     Style="{StaticResource ListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>

