<Page
    x:Class="IziTravel.Views.Forum.ForumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IziTravel.Views.Forum"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:forum="local:IziTravel.AppServices.ViewModels.Forum;assembly=IziTravel.AppServices"
    xmlns:micro="local:Caliburn.Micro;assembly=Caliburn.Micro"
    xmlns:behaviors="clr-namespace:IziTravel.Interaction.Behaviors"
    xmlns:i="clr-namespace:IziTravel.Interaction"
    xmlns:tp="using:Telerik.UI.Xaml.Controls.Primitives"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:controls="using:Izi.Travel.Shell.Controls"
    xmlns:dataModels="local:IziTravel.AppServices.DataModels;assembly=IziTravel.AppServices" 
    xmlns:forum1="using:IziTravel.AppServices.ViewModels.Forum"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type=forum1:ForumPageViewModel}"   
    >
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedItemsSource" 
                            IsSourceGrouped="True" 
                            Source="{Binding AllItems}">
            <!-- In UWP, grouping is typically done in the ViewModel -->
            <!-- The collection should be pre-grouped in the ViewModel and exposed as a grouped collection -->
        </CollectionViewSource>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource IziTravelLightBrush}"
                Height="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <tp:RadTransitionControl
                    Content="{Binding ForumName, Converter={StaticResource StringCaseConverter}, ConverterParameter=l}"
                    Name="Title">
                    <tp:RadTransitionControl.Transition>
                        <tp:RadTransition PlayMode="Simultaneously">
                            <tp:RadTransition.ForwardOutAnimation>
                                <telerik:RadMoveXAnimation EndX="-480" Duration="0:0:1">
                                    <telerik:RadMoveXAnimation.Easing>
                                        <PowerEase Power="4" EasingMode="EaseOut" />
                                    </telerik:RadMoveXAnimation.Easing>
                                </telerik:RadMoveXAnimation>
                            </tp:RadTransition.ForwardOutAnimation>
                            <tp:RadTransition.ForwardInAnimation>
                                <telerik:RadMoveXAnimation StartX="480" EndX="0" Duration="0:0:0.5">
                                    <telerik:RadMoveXAnimation.Easing>
                                        <PowerEase Power="4" />
                                    </telerik:RadMoveXAnimation.Easing>
                                </telerik:RadMoveXAnimation>
                            </tp:RadTransition.ForwardInAnimation>
                        </tp:RadTransition>
                    </tp:RadTransitionControl.Transition>
                    
                    <tp:RadTransitionControl.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding }"
                                       VerticalAlignment="Center"
                                       Margin="24 0 0 0"
                                       Style="{StaticResource PhoneTextTitle2Style}" />
                        </DataTemplate>
                    </tp:RadTransitionControl.ContentTemplate>

                </tp:RadTransitionControl>

                                <controls:QmsControl Grid.Column="2"
                                     Margin="0 9 0 0"
                                     VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="0 32 0 0">
                            <telerik:RadListView ItemsSource="{Binding Source={StaticResource GroupedItemsSource}}"
                                     Style="{StaticResource ListBoxStyle}"
                                     behaviors:ListBoxBehavior.DisableSelection="True">
                <telerik:RadListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" Padding="12">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </telerik:RadListView.GroupStyle>
                <telerik:RadListView.ItemTemplateSelector>
                    <i:ForumDataTemplateSelector>
                        <i:ForumDataTemplateSelector.ForumTemplate>
                            <DataTemplate>
                                 <Grid Margin="24 12 0 12"
                                    Tapped="ForumItem_Tapped"
                                    Tag="{Binding}">
                                    <TextBlock Text="{Binding Title}"
                                               Margin="0 -9 0 0"
                                               TextWrapping="Wrap"
                                               FontWeight="Bold"
                                               Style="{StaticResource PhoneTextTitle2Style}" />
                                </Grid>
                            </DataTemplate>
                        </i:ForumDataTemplateSelector.ForumTemplate>
                        
                        <i:ForumDataTemplateSelector.TopicTemplate>
                            <DataTemplate>

                                <Grid Margin="24 12 0 12"
                                          d:DataContext="{d:DesignInstance dataModels:TopicDataModel}">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                                   Margin="0 -9 0 0"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Segoe WP Light"                                                   
                                                   FontSize="28" />

                                    <StackPanel Orientation="Horizontal"
                                                Grid.Row="1">

                                        <TextBlock Margin="0"
                                                   Style="{StaticResource PhoneTextSmallStyle}">
                                            <Run Text="{Binding LastMessageTime}"/>
                                            <Run Text="-"/>
                                            <Run Text="{Binding AuthorName}"/>
                                        </TextBlock>
                                    </StackPanel>

                                </Grid>
                                
                              
                            </DataTemplate>
                        </i:ForumDataTemplateSelector.TopicTemplate>

                    </i:ForumDataTemplateSelector>
                </telerik:RadListView.ItemTemplateSelector>
                    
                                <telerik:RadListView.ItemAddedAnimation>
                    <telerik:FadeAnimation />
                </telerik:RadListView.ItemAddedAnimation>
                    
                                <telerik:RadListView.ItemRemovedAnimation>
                    <telerik:FadeAnimation EndOpacity="0" StartOpacity="1" />
                </telerik:RadListView.ItemRemovedAnimation>
            </telerik:RadListView>

        </Grid>
    </Grid>
</Page>

